# This is an example .env file for a Next.js application using BetterAuth.
# Copy this file to .env and fill in the required values before running your application.

# Database connection strings
DATABASE_URL=
DIRECT_URL=

# BetterAuth configuration
BETTER_AUTH_SECRET=

# Next.js configuration
# URL pública da app. Usada por lib/auth (server + client) e pela metadata.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admins — e-mails separados por vírgula. Quem se cadastrar com um deles
# já nasce com papel "admin". Só vale na criação da conta; depois, troque o
# papel em /admin/users. Opcional.
ADMIN_EMAILS=

# OAuth provider credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# E-mail (Resend) — opcional.
# Sem RESEND_API_KEY os e-mails são impressos no terminal (transporte "console").
RESEND_API_KEY=
EMAIL_FROM="Meu Template <onboarding@resend.dev>"