# This is an example .env file for a Next.js application using BetterAuth.
# Copy this file to .env and fill in the required values before running your application.

# Database connection strings
DATABASE_URL=
DIRECT_URL=

# BetterAuth configuration
BETTER_AUTH_SECRET=

# Next.js configuration
# URL pública da app. Usada por lib/auth (server + client) e pela metadata.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# OAuth provider credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Brevo / Nodemailer configuration
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=

BREVO_SMTP_USER=
BREVO_SMTP_PASS=

BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=


# Cron job secret
CRON_SECRET=